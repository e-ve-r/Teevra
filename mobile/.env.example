# Example for a physical device on the same trusted network as the backend.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000
# Build-time setting for a standalone Android Maps SDK; restrict the key in Google Cloud.
# GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-key
# Set only when building an Android development app against a local HTTP backend.
# TEEVRA_ALLOW_HTTP=1
